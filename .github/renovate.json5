// Keeps the pinned container images current (docs/updates.md). Run by
// .github/workflows/renovate.yml every morning at 04:45 UTC. Digest, patch and
// minor bumps merge straight to main, where Flux applies them within a minute;
// major bumps, and minor ones of the data stores below, open a pull request.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":disableRateLimiting"],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate: pending image updates",
  // Only the cluster; docker-compose.yml and config/ are the frozen Docker VM.
  // Not github-actions: a GITHUB_TOKEN may not push changes to workflow files.
  enabledManagers: ["kubernetes"],
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  // A GITHUB_TOKEN push starts no workflow, so there are never checks to wait
  // for. A broken image shows up in Gatus and the alerts instead.
  ignoreTests: true,
  packageRules: [
    {
      matchUpdateTypes: ["digest", "patch", "minor", "pin", "pinDigest"],
      automerge: true,
      automergeType: "branch",
      // One branch for all of them: Renovate restarts after each automerge
      // and stops after the second, so separate branches took weeks.
      groupName: "image updates",
    },
    {
      // Built from Erik's own repos and imported or pushed by their deploy
      // scripts; their tags are commits, not versions.
      matchPackageNames: [
        "ghcr.io/erikfrankling/**",
        "docker.io/library/brain",
        "brain",
      ],
      enabled: false,
    },
    {
      // Not reconciled by Flux (kubernetes/optional/media is inactive).
      matchFileNames: ["kubernetes/optional/**"],
      enabled: false,
    },
    {
      // Data formats change across these; a person reads the notes first.
      matchPackageNames: [
        "docker.io/library/postgres",
        "docker.io/library/redis",
        "docker.io/opensearchproject/opensearch",
        "docker.io/onyxdotapp/**",
      ],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
      groupName: null,
    },
  ],
}
